{
  "name": "antigravity-skills-catalog",
  "version": "1.0.0",
  "description": "Universal Google Antigravity Skills Catalog Manager (CLI & Web GUI)",
  "main": "scripts/skills-cli.js",
  "bin": {
    "skills-catalog": "scripts/skills-cli.js",
    "skill-hub": "scripts/skills-cli.js"
  },
  "scripts": {
    "ui": "node web/server.js",
    "web": "node web/server.js",
