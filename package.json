{
  "name": "antigravity-skills-catalog",
  "version": "1.0.0",
  "description": "Universal Google Antigravity Skills Catalog Manager (CLI & Web GUI)",
  "main": "scripts/skills-cli.js",
  "bin": {
    "skills-catalog": "scripts/skills-cli.js",
    "skill-hub": "scripts/skills-cli.js"
  },
  "files": [
    ".agents",
    "scripts",
    "web",
    "postinstall.js",
    "README.md",
    "package.json",
    "start-ui.bat"
  ],
  "scripts": {
    "postinstall": "node -e \"try { require('./postinstall.js'); } catch (e) { try { require('./scripts/postinstall.js'); } catch(e2) {} }\"",
    "ui": "node web/server.js",
    "web": "node web/server.js",
    "start": "node web/server.js",
    "cli": "node scripts/skills-cli.js",
    "list": "node scripts/skills-cli.js list",
    "status": "node scripts/skills-cli.js status",
    "update": "node scripts/skills-cli.js update",
    "sync": "node scripts/skills-cli.js sync",
    "install:global": "node scripts/skills-cli.js install --all --global",
    "install:local": "node scripts/skills-cli.js install --all --local"
  },
  "keywords": [
    "antigravity",
    "skills",
    "skills-catalog",
    "roblox",
    "unity",
    "git",
    "ai-agent",
    "agentic-coding"
  ],
  "author": "Anzar",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/unknown1777101/skills-catalog.git"
  }
}
